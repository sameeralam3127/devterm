# devterm starship config — theme: @@display@@
# Generated by tools/build.py. Edit themes/*.json or templates/, then rebuild.
# Context modules only appear when relevant to the current folder.

add_newline = true
command_timeout = 1000

format = """
$directory\
$git_branch\
$git_status\
$kubernetes\
$aws\
$terraform\
${custom.ansible}\
$python\
$golang\
$nodejs\
$docker_context\
$cmd_duration
$character"""

right_format = "$time"

# ── Location ─────────────────────────────────────────
[directory]
style = "bold @@blue@@"
truncation_length = 3
truncate_to_repo = true
read_only = " 󰌾"
read_only_style = "@@red@@"
format = '[ $path]($style)[$read_only]($read_only_style) '

# ── Git ──────────────────────────────────────────────
[git_branch]
symbol = " "
style = "bold @@purple@@"
format = '[$symbol$branch]($style) '

[git_status]
style = "@@yellow@@"
format = '([\[$all_status$ahead_behind\]]($style) )'

# ── Kubernetes: only inside k8s / helm / kustomize folders ──
[kubernetes]
disabled = false
symbol = "󱃾 "
style = "bold @@cyan@@"
format = '[$symbol$context( \($namespace\))]($style) '
detect_files = ["Chart.yaml", "kustomization.yaml", "helmfile.yaml", "skaffold.yaml", "Tiltfile"]
detect_folders = ["k8s", "charts", "manifests", "helm", "kubernetes"]
detect_extensions = []

[[kubernetes.contexts]]
context_pattern = "docker-desktop"
context_alias = "local"
style = "@@muted@@"

[[kubernetes.contexts]]
context_pattern = ".*prod.*"
style = "bold @@red@@"

# ── Cloud / IaC ──────────────────────────────────────
[aws]
symbol = " "
style = "bold @@yellow@@"
format = '[$symbol($profile)( \($region\))]($style) '

[terraform]
symbol = "󱁢 "
style = "bold @@purple@@"
format = '[$symbol$workspace]($style) '

[custom.ansible]
detect_files = ["ansible.cfg", "galaxy.yml", "requirements.yml", "site.yml"]
symbol = "󱂚 "
style = "bold @@red@@"
format = '[$symbol ansible]($style) '

# ── Languages ────────────────────────────────────────
[python]
symbol = " "
style = "@@green@@"
format = '[$symbol$version( \($virtualenv\))]($style) '
detect_files = [
  "requirements.txt", "requirements-dev.txt", "pyproject.toml", "setup.py",
  "setup.cfg", "Pipfile", "tox.ini", "pytest.ini", ".python-version", "__init__.py",
]

[golang]
symbol = " "
style = "@@cyan@@"
format = '[$symbol$version]($style) '

[nodejs]
symbol = " "
style = "@@green@@"
format = '[$symbol$version]($style) '

[docker_context]
symbol = " "
style = "@@blue@@"
only_with_files = true
format = '[$symbol$context]($style) '

# ── Timing ───────────────────────────────────────────
[cmd_duration]
min_time = 2000
style = "@@yellow@@"
format = '[ $duration]($style) '

[time]
disabled = false
style = "@@muted@@"
time_format = "%H:%M"
format = '[$time]($style)'

# ── Prompt symbol: green on success, red on error ────
[character]
success_symbol = "[❯](bold @@green@@)"
error_symbol = "[❯](bold @@red@@)"
