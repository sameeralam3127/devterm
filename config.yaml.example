# DevOps Toolkit Configuration File
# Copy this file to /etc/devops_toolkit/config.yaml and customize

# Slack Notification Settings
slack:
  webhook_url: 'https://hooks.slack.com/services/YOUR/WEBHOOK/URL'
  enabled: true
  retry_attempts: 3
  retry_delay: 2

# Monitoring Configuration
monitoring:
  # Disk Usage Monitoring
  disk:
    enabled: true
    threshold_percent: 80
    paths:
      - /
      - /home
      - /var
  
  # CPU Usage Monitoring
  cpu:
    enabled: true
    threshold_percent: 80
    check_interval: 5
  
  # Memory Usage Monitoring
  memory:
    enabled: true
    threshold_percent: 80
  
  # Port Availability Monitoring
  ports:
    enabled: true
    check_ports:
      - 22    # SSH
      - 80    # HTTP
      - 443   # HTTPS
      - 3306  # MySQL (if applicable)
      - 5432  # PostgreSQL (if applicable)
  
  # Process Monitoring
  processes:
    enabled: true
    watch_processes:
      - nginx
      - apache2
      - mysql
      - postgresql
      - docker

# Maintenance Configuration
maintenance:
  # Patch Management
  patch_management:
    enabled: true
    auto_reboot: false
    reboot_time: '03:00'
  
  # Service Management
  services:
    restart_retry_count: 3
    restart_retry_delay: 5

# Audit Configuration
audit:
  # File Permissions Audit
  file_permissions:
    enabled: true
    scan_paths:
      - /etc
      - /var/www
      - /opt
    exclude_paths:
      - /proc
      - /sys
      - /dev
      - /run
  
  # User and Group Audit
  user_audit:
    enabled: true
  
  # Cron Job Audit
  cron_audit:
    enabled: true

# Logging Configuration
logging:
  log_file: /var/log/devops_toolkit.log
  log_level: INFO
  max_bytes: 10485760  # 10MB
  backup_count: 5